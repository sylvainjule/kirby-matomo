{
    "name": "sylvainjule/matomo",
    "description": "Matomo helpers, panel area and sections for Kirby",
    "type": "kirby-plugin",
    "license": "MIT",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Sylvain Julé",
            "email": "contact@sylvain-jule.fr"
        },
        {
            "name": "Sören Engels"
        },
        {
