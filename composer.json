            "email": "mail@philipptrenz.de"
        }
    ],
    "require": {
        "getkirby/composer-installer": "^1.2"
    },
    "extra": {
        "installer-name": "matomo",
        "kirby": {
            "compatible": "^6.0"
        }
    },
    "minimum-stability": "beta",
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    }
